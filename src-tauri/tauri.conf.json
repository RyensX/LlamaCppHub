{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicetauri/main/packages/schema/schema.json",
  "productName": "LlamaCppHub",
  "version": "0.1.0",
  "identifier": "com.llamacpphub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LlamaCppHub",
        "width": 1260,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
